{
  "name": "@mytoolhub/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MyToolHub 后端服务（Fastify + TypeORM + SQLite）",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
